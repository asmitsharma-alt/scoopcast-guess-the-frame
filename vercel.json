{
  "version": 2,
  "cleanUrls": true,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/(css|android/css|android/js|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(avvtar|android/avvtar)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/logo.png",
      "destination": "https://res.cloudinary.com/xxvk1ruz/image/upload/v1789799633/scoopcast/logo.png",
      "permanent": false
    },
    {
      "source": "/android/logo.png",
      "destination": "https://res.cloudinary.com/xxvk1ruz/image/upload/v1789799633/scoopcast/logo.png",
      "permanent": false
    },
    {
      "source": "/desktop/logo.png",
      "destination": "https://res.cloudinary.com/xxvk1ruz/image/upload/v1789799633/scoopcast/logo.png",
      "permanent": false
    },
    {
      "source": "/android",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/android/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/desktop",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/desktop/",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Aa]ndroid|[Ii][Pp]hone|[Ii][Pp]od|[Ii][Pp]ad|[Mm]obile|[Ww]eb[Oo][Ss]|BlackBerry|IEMobile|Opera Mini).*"
        }
      ],
      "destination": "/mobile_app"
    },
    {
      "source": "/",
      "destination": "/desktop_app"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Aa]ndroid|[Ii][Pp]hone|[Ii][Pp]od|[Ii][Pp]ad|[Mm]obile|[Ww]eb[Oo][Ss]|BlackBerry|IEMobile|Opera Mini).*"
        }
      ],
      "destination": "/mobile_app"
    },
    {
      "source": "/index.html",
      "destination": "/desktop_app"
    },
    {
      "source": "/desktop/css/:match*",
      "destination": "/css/:match*"
    },
    {
      "source": "/desktop/avvtar/:match*",
      "destination": "/avvtar/:match*"
    },
    {
      "source": "/android/avvtar/:match*",
      "destination": "/avvtar/:match*"
    },
    {
      "source": "/css/android.css",
      "destination": "/android/css/android.css"
    },
    {
      "source": "/js/:match*",
      "destination": "/android/js/:match*"
    }
  ]
}
